# Server-side Google Tag Manager (sGTM) Configuration

# The Base64 CONTAINER_CONFIG string generated in Google Tag Manager UI for this store
# (Admin -> Container Settings -> Manually provision your tagging server)
SGTM_CONTAINER_CONFIG=aW5pdGlhbGl6ZV9jb250YWluZXJfY29uZmlnX3N0cmluZ19oZXJl

# Enable Preview / Debug mode (true/false) - default is false
RUN_AS_PREVIEW_SERVER=false
